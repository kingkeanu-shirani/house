        "label_text": "WET CHEMICAL CLASS K. For cooking oil fires. Apply gently as a mist from 1-3 m. Not for energized equipment."}},
    "fire_blanket": {"is_a": "portable_object", "doc": "1.2 x 1.2 m fiberglass blanket in a quick-release pouch (EN 1869).",
      "props": {"label": "fire blanket", "category": "fire_blanket", "smother_kind": "fire_blanket", "blanket_size_m": 1.2, "max_cover_kw": 250.0,
