    "fire_extinguisher": {"is_a": "portable_object", "doc": "5 lb (2.3 kg) stored-pressure ABC dry chemical, UL 2-A:10-B:C. ~14 s discharge, 3-5 m range.",
      "props": {"label": "fire extinguisher", "category": "fire_extinguisher", "extinguisher": true, "agent": "abc_dry_chemical",
        "rating": "2-A:10-B:C", "agent_kg": 2.3, "agent_left_kg": 2.3, "discharge_s": 14.0, "range_m": [1.5, 4.5], "pin_in": true,
        "tamper_seal": "intact", "gauge": "green", "needs_recharge": false, "aimed_at": null, "aim_point": null,
        "mass_kg": 4.3, "size_m": [0.13, 0.13, 0.48], "volume_l": 6.0, "material": "steel", "color": "red", "value": 45.0,
        "label_text": "ABC DRY CHEMICAL 2-A:10-B:C. P-A-S-S: PULL the pin. AIM low at the base of the fire. SQUEEZE the handle. SWEEP side to side. Stand 2-3 m (6-8 ft) back with an exit behind you. Gauge needle must be in the green. Recharge after ANY use.",
        "affordances": ["pull_pin", "aim", "discharge"], "capabilities": ["extinguish"], "tags": ["safety_equipment", "fire_safety"]},
      "perception": {"inspect": ["gauge", "pin_in", "tamper_seal", "needs_recharge"], "read": ["agent", "rating", "agent_kg", "discharge_s", "range_m"], "measure": {"agent_left_kg": "scale"}, "hidden": ["aim_from", "aim_dist_m"]}},
    "fire_extinguisher_compact": {"is_a": "fire_extinguisher", "doc": "2.5 lb (1.1 kg) ABC, UL 1-A:10-B:C, ~9 s discharge.",
      "props": {"label": "small fire extinguisher", "rating": "1-A:10-B:C", "agent_kg": 1.1, "agent_left_kg": 1.1, "discharge_s": 9.0,
        "range_m": [1.0, 3.5], "mass_kg": 2.2, "size_m": [0.09, 0.09, 0.38], "volume_l": 2.6, "value": 30.0}},
    "co2_extinguisher": {"is_a": "fire_extinguisher", "doc": "5 lb CO2, UL 5-B:C. Poor on class A (embers rekindle). Short range.",
      "props": {"label": "CO2 fire extinguisher", "agent": "co2", "rating": "5-B:C", "agent_kg": 2.3, "agent_left_kg": 2.3, "discharge_s": 9.0,
