{
  "domain": "mechanisms",
  "field_tiers": {
    "doc": "Fields this domain writes onto any entity (doors, windows, drawers, cabinets, lids, dispensers, sprayers, tyres, panels of other domains' devices). The raw mechanism dict is never perceived: inspect gives the seen view ('mechanism'); latch/lock/seal state needs a close look; obvious states are glance; ratings, doses and bookkeeping are hidden; a tyre's inflation needs a pressure gauge.",
    "glance": ["ajar", "pooled", "water_running", "light_on", "off_slides", "taped_over", "hanging_on"],
    "inspect": ["latched", "child_lock", "lid_cracked", "shackle_closed"],
    "measure": {"inflatable": "pressure_gauge"},
    "hidden": ["mech", "in_track", "leans_on_door", "pages_skipped", "passed", "waiting_at", "propping", "props_open", "applied", "damage_notes",
               "pump.ml_per_stroke", "pump.primed", "pump.prime_strokes", "pump.stroke_l", "pump.max_kpa",
               "trigger.ml_per_squeeze", "trigger.cone_deg", "trigger.flow_lpm",
               "panel.buttons", "panel.factory_settings", "panel.hold_to_start_s", "panel.lock_button", "panel.touch_sensitive",
               "panel.wipe_press", "panel.clean_lock"],
    "room": {"hidden": ["wet_cells"]}
  },
