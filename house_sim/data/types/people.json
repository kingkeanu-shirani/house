  "field_tiers": {
    "doc": "Fields the people domain writes onto (or reads from) any entity or room. Seen at a glance: a book left open face down, an item a person holds out to the robot, mail. Up close: a bookmark, a latch that shuts from outside, a low soft seat, fastened buttons and laces. Printed: a patient's name and an addressee. Never seen (asked or inferred): whose phone it is or whether its screen is private, who a present is hidden from, who hid something, who it was meant for, a reader's lost page, hosting roles (centerpiece, station, clutter, found spot), kosher classes, private writing, the robot's last thermometer note. Rooms: the grader's hosting metrics and scenario creak cells are not perceived.",
    "glance": ["open_face_down", "offered", "mail_piece"],
    "inspect": ["bookmarked", "latches_shut", "entrapment_hazard", "low_soft", "fastened", "laced", "on_feet"],
    "read": ["patient_name", "addressee"],
    "hidden": ["phone_of", "screen_private", "secret_from", "hidden_by", "recipient_id", "shared_with", "page_lost", "hiding_spot",
               "centerpiece", "station", "clutter", "found_spot", "kosher_class", "diary", "private_writing", "in_pocket",
               "last_measured_c", "gate_for", "sensitive"],
    "room": {"hidden": ["metrics", "track_metrics", "creak_cells"]}
  },
