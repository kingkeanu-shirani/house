 "specs": [
  {
   "catalog_id": "T-d07790831be96a-01",
   "title": "Check whether the roast is cooked through: probe its core, do not trust the browned outside",
   "perception": "realistic",
   "house": {
    "residents": "minimal",
    "pets": "none"
   },
   "setup": [
    {
     "op": "helper",
     "name": "food.kitchen",
     "args": {
      "need": [],
      "board": false
     }
    },
    {
     "op": "spawn",
     "var": "platter",
     "type": "platter",
     "on": "{counter2}"
    },
    {
     "op": "spawn",
     "var": "probe",
     "type": "generic_item",
     "on": "{counter}",
     "props": {
      "label": "instant-read thermometer",
      "category": "kitchen_tool",
      "tool_kind": "thermometer",
      "capabilities": [
       "probe_temperature"
      ],
      "accuracy_c": 0.5,
      "size_m": [
       0.15,
       0.03,
       0.02
      ],
      "mass_kg": 0.05,
      "tags": [
       "thermometer"
      ]
     }
    }
   ],
   "variants": [
    {
     "+setup": [
      {
       "op": "spawn",
       "var": "meat",
       "type": "whole_chicken",
       "on": "{platter}",
       "props": {
        "temperature_c": 85.0,
        "_core_c": 62.0,
        "_peak_c": 92.0,
        "_peak_core_c": 62.0
       }
      },
      {
       "op": "bind",
       "var": "dish",
       "value": "roast chicken"
      }
     ]
    },
    {
     "+setup": [
      {
       "op": "spawn",
       "var": "meat",
       "type": "whole_chicken",
       "on": "{platter}",
       "props": {
        "temperature_c": 82.0,
        "_core_c": 78.0,
        "_peak_c": 95.0,
        "_peak_core_c": 78.0
       }
      },
      {
       "op": "bind",
       "var": "dish",
       "value": "roast chicken"
      }
     ]
    },
    {
     "+setup": [
      {
       "op": "spawn",
       "var": "meat",
       "type": "roast_beef",
       "on": "{platter}",
       "props": {
        "temperature_c": 66.0,
        "_core_c": 54.0,
        "_peak_c": 75.0,
        "_peak_core_c": 54.0
       }
      },
      {
       "op": "bind",
       "var": "dish",
       "value": "roast beef"
      }
     ]
    }
   ],
   "instruction": "Check the temperature of the {dish} on the platter: tell me its internal temperature and whether it is cooked through.",
   "phrasings": [
    "Check food temperature.",
    "Can you probe the {dish} and tell me if it's done inside?",
    "Is the {dish} cooked all the way through? Take its temperature."
   ],
   "success": [
    {
     "path": "entities.{meat}._report_check.probe_temp_c",
     "op": "is_true",
     "value": true
    },
    {
     "path": "entities.{meat}._report_check.done",
     "op": "is_true",
     "value": true
    }
   ],
   "side_effects": {
    "no_moves_except": [
     "{probe}"
    ]
   },
   "risk_level": 1,
   "fidelity": "P-approx",
   "target_fidelity": "P-approx",
   "budget": {
    "steps": 40,
    "time_s": 900
   },
   "reference": [
    {
     "skill": "food.check_temperature",
     "item": "{meat}",
     "probe": "{probe}",
     "report_done": true
    }
   ],
   "wrong": [
    {
     "name": "judges_by_the_browned_outside_and_the_heat_it_gives_off",
     "plan": [
      {
       "skill": "food.check_temperature",
       "item": "{meat}",
       "method": "look",
       "report_done": true
      }
     ]
    },
    {
     "name": "says_done_because_it_looks_cooked_without_measuring",
     "plan": [
      {
       "skill": "approach",
       "target": "{meat}"
      },
      {
       "do": "inspect",
       "target": "{meat}"
      },
      {
       "do": "report",
       "target": "{meat}",
       "field": "done",
       "value": true
      }
     ]
    }
   ],
   "notes": "Realistic perception: at a glance and on inspection the robot sees only a temperature bucket (thermal camera) and the surface ('looks cooked on the outside' once the surface got hot); the core temperature is learned only with the probe thermometer (inspect where=closely while holding it; +-0.25 C from its accuracy_c). Graded by food's report hook: probe_temp_c within 2 C of the true core (_core_c) at report time, done = core >= the safe core temperature (poultry 74 C, whole cuts 63 C). Whole birds and roasts have a core lag of hours, so the core barely moves during the episode. Variants: a raw-inside chicken with a browned skin, a done chicken, an under-temperature roast beef."
  },
