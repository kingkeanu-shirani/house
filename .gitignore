__pycache__/
*.pyc
build/
dist/
*.egg-info/
.venv/
state.json
replay.json

# private evaluation material (never commit or package; docs/SPLITS.md)
.house_ai/
split_key
test_manifest.json
test_phrasings.json
verifier_key
results/
# test-split replays, transcripts and private viewer pages (normally in ~/.house_ai/private_results/)
private_results/
# private viewer pages and other private exports (viewer.py names them <name>__PRIVATE.html)
*__PRIVATE.html
*__PRIVATE.*
*__PRIVATE/

# stale generated files moved aside (contain local paths; regenerate instead)
archive/stale_*/
# earlier git history, imported into this repository instead
history.bundle
# local snapshot archives (kept on disk, not in git)
archive/*.zip
tools/orchestration/green_tests.json
# tier-1 gate records (local working data, large and machine-specific; regenerate with tools/orchestration/tier1_gate.py)
catalog/analysis/tier1/gate/
# demo replays are large (about 3 MB each); regenerate with python -m house_sim --demo
demos/replays/
